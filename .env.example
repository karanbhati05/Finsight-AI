# FinSight AI - Environment Configuration Template

# Server & Redis Cache
PORT=8000
REDIS_URL=redis://localhost:6379

# Google Gemini API (RAG Financial Analyst & Research Memos)
GOOGLE_API_KEY=your_gemini_api_key_here

# Federal Reserve FRED API (10Y/2Y Yield Curve, CPI, Fed Funds Rate)
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage / Twelve Data (Technical Indicators: RSI, MACD, EMAs)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Financial Modeling Prep (FMP) (5-Year Statements & Financial Ratios)
FMP_API_KEY=your_fmp_api_key_here

# Finnhub Financial API (Live Quotes, News & Wall St Targets)
FINNHUB_API_KEY=your_finnhub_api_key_here

# CoinGecko API (Top 20 Cryptocurrencies & Forex Matrix)
COINGECKO_API_KEY=your_coingecko_api_key_here

# NewsAPI (Global Financial News Feed)
NEWS_API_KEY=your_news_api_key_here
